body {
  background-color: rgb(150, 145, 138);

  /* background-position: center; */
}
.header {
  border: 5px dashed white;
  /* border-bottom: 20px solid white; */
  border-radius: 40px;
  height: 300px;
  /* width: 300px; */
  background-image: url(./src/assets/background.jpg);
  background-size: cover;
  /* background-repeat: no-repeat; */
}
.box1 {
  width: 100px;
  height: 100px;
  background-color: rgb(115, 255, 0);
  /* inline-block gives us a combination: inline behaviour + box dimensions */
  /* since we can assign dimensions in block and inline elements stay in a single line */
  display: inline-block;
  margin: 10px;
}
#newBox {
  width: 200px;
  height: 200px;
  background-color: rgb(53, 59, 144);

  /* display: inline-block; */
  margin: 10px;
}
span {
  font-size: 40px;
  border: 2px solid red;
  margin: 0px 20px;
  padding: 10px;
}
.spanDiv {
  margin-top: 40px;
}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../bbd.css" />
    <title>Document</title>
  </head>
  <body>
    <!-- Background : img/size/repeat -->
    <div class="header"></div>
    <!-- Border : Styles/Radius/Thickness -->

    <!-- Display : Inline/ Block/ Inline-Block / none : → disappears + space disappears-->
    <div>
      <div class="box1"></div>
      <div class="box1" id="newBox"></div>
      <div class="box1"></div>
    </div>

    <div class="spanDiv">
      <span>one</span>
      <span>two</span>
      <span>three</span>
      <span>four</span>
    </div>

    <!-- min/max Width and Height -->
  </body>
</html>
