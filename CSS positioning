.parent {
  border: 2px solid black;
  padding: 20px;
  /* position: relative; */
}
.child {
  border: 2px solid black;
  font-size: 40px;
  height: 200px;
  width: 200px;
  text-align: center;
  background-color: steelblue;
  display: inline-block;
}

#child3 {
  position: absolute;
  /* top: 200px;
  /* right: 100px; */
}
#child2 {
  position: absolute;
  /* top: 150px; */
  /* left: 100px; */
}

#relativeProp {
  position: relative;
  top: 100px;
}
#absoluteProp {
  position: absolute;
  top: 100px;
}
#staticProp {
  position: static;
}
